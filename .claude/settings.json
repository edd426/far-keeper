{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f*)",
      "Bash(rm -rf:*)"
    ],
    "allow": [
      "Read(**)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout -B main HEAD)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin*)",
      "Bash(git pull)",
      "Bash(git pull:*)",
      "Bash(./scripts/build.sh)",
      "Bash(./scripts/build.sh:*)",
      "Bash(./scripts/local-snapshot.sh)",
      "Bash(./scripts/local-snapshot.sh:*)",
      "Bash(./scripts/wait-for-deploy.sh)",
      "Bash(./scripts/wait-for-deploy.sh:*)",
      "Bash(./scripts/verify-deploy.sh:*)",
      "Bash(./scripts/lint-diary.sh:*)",
      "Bash(./scripts/lint-log.sh:*)",
      "Bash(./scripts/lint-commonplace.sh:*)",
      "Bash(curl:*)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(grep:*)",
      "Bash(wc:*)"
    ]
  }
}
